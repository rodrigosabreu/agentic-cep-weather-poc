# Agentic CEP Weather POC - Environment Variables
# Copy to .env and fill in the values

# LLM Provider Configuration
# Primary: OpenAI (Function Calling support required)
LLM_PROVIDER=OpenAI

# OpenAI API Key (REQUIRED for primary provider)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# NVIDIA (fallback - disabled by default)
NVIDIA_API_KEY=
NVIDIA_ENABLED=false

# External APIs (no auth required)
# VIACEP_BASE_URL=https://viacep.com.br/ws
# OPENMETEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
# OPENMETEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# Server
ASPNETCORE_URLS=http://0.0.0.0:5000
