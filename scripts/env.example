# Agentic CEP Weather POC - Configuração de Ambiente
# Copie este arquivo para .env e preencha os valores

# ===========================================
# LLM PROVIDERS (pelo menos um é OBRIGATÓRIO)
# ===========================================

# NVIDIA API (provedor primário recomendado)
# Obtenha em: https://build.nvidia.com/
NVIDIA_API_KEY=

# OpenAI API (fallback)
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ===========================================
# SERVIDOR
# ===========================================

# URLs para bind (padrão: http://0.0.0.0:5000)
ASPNETCORE_URLS=http://0.0.0.0:5000

# Ambiente (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=Production

# ===========================================
# CORS (origens permitidas para o frontend)
# ===========================================

# Separe múltiplas origens por vírgula
# Ex: ALLOWED_ORIGINS=https://meusite.com,https://www.meusite.com
ALLOWED_ORIGINS=*

# ===========================================
# LOGGING
# ===========================================

# Nível de log (Trace, Debug, Information, Warning, Error, Critical)
LOG_LEVEL=Information

# ===========================================
# TIMEOUTS (opcionais - valores padrão funcionam bem)
# ===========================================

# Timeout para requisições LLM (segundos)
LLM_REQUEST_TIMEOUT=30

# Timeout para inicialização (segundos)
LLM_INIT_TIMEOUT=30

# Timeout para parada graciosa (segundos)
LLM_STOP_TIMEOUT=15

# Máximo de iterações de tool calling
LLM_MAX_TOOL_ITERATIONS=5

# ===========================================
# APIs EXTERNAS (geralmente não precisam mudar)
# ===========================================

# ViaCEP
VIACEP_BASE_URL=https://viacep.com.br/ws
VIACEP_TIMEOUT=10

# Open-Meteo
OPENMETEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPENMETEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPENMETEO_TIMEOUT=10